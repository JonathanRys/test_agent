# Shared fallback values for any environment.
# Environment-specific files take precedence:
#   .env.development / .env.staging / .env.production
# Secrets should live in the environment-specific files, not here.
PORT=3001
ADMIN_USERS=admin@example.com;owner@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Trail Guide <no-reply@example.com>

OPENROUTER_API_KEY=<your_api_key_here>
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_CONTEXT_SUMMARY_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTING_API_BASE_URL=https://router.project-osrm.org/table/v1/driving

VITE_GOOGLE_MAPS_API_KEY=<your_api_key_here>